### 2. NAT(PAT) на R18. Трансляция в пул из 5 адресов автономной системы AS2042

#### R18 - NAT(PAT)

```
enable
configure terminal

ip access-list standard NAT_INSIDE
 permit 10.20.42.0 0.0.0.255
exit

ip nat pool AS2042_POOL 10.204.2.1 10.204.2.5 netmask 255.255.255.248

ip nat inside source list NAT_INSIDE pool AS2042_POOL overload

interface Ethernet0/0
 ip nat inside
exit

interface Ethernet0/1
 ip nat inside
exit

interface Ethernet0/2
 ip nat outside
exit

interface Ethernet0/3
 ip nat outside
exit

end
write memory
```

```
ip route 10.204.2.0 255.255.255.248 Null0

router bgp 2042
 address-family ipv4
  network 10.204.2.0 mask 255.255.255.248
 exit-address-family
```

